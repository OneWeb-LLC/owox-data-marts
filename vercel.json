{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:owox && npm run build:vercel",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{apps/web/dist/**,apps/backend/dist/**,packages/*/dist/**,packages/idp-better-auth/src/templates/**,packages/idp-owox-better-auth/src/resources/**}"
    }
  }
}
